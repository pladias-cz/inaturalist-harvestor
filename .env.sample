# Required
INAT_USERNAME=
INAT_PASSWORD=
INAT_CLIENT_ID=
INAT_CLIENT_SECRET=
DATABASE_URL=postgresql://pladias:pladias@localhost:7777/pladias

# Optional
# daily | full
IMPORT_MODE=daily
# seconds between paginated iNaturalist requests
REQUEST_DELAY=1
# seconds between ChecklistBank resolution requests
CHECKLISTBANK_REQUEST_DELAY=0.2
USER_AGENT=pladias-inaturalist-importer/1.0
LOG_LEVEL=INFO
